doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Qi Chen - Full-stack Developer
    //- Google Fonts for a cleaner look
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap", rel="stylesheet")
    //- Font Awesome for icons
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    style.
      :root {
        --bg-color: #e0e5ec;
        --primary-text-color: #3d4a6d;
        --secondary-text-color: #5b6785;
        --highlight-color: #3498db;
        --shadow-light: #ffffff;
        --shadow-dark: #a3b1c6;
        --card-border-radius: 20px;
        --card-padding: 2rem;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Poppins', sans-serif;
        line-height: 1.8;
        background-color: var(--bg-color);
        color: var(--secondary-text-color);
        padding: 40px 20px;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        gap: 30px;
      }
      
      .card {
        background: var(--bg-color);
        border-radius: var(--card-border-radius);
        padding: var(--card-padding);
        box-shadow: 9px 9px 16px var(--shadow-dark), -9px -9px 16px var(--shadow-light);
        transition: all 0.3s ease-in-out;
      }

      .card:hover {
        transform: translateY(-5px);
        box-shadow: 12px 12px 20px var(--shadow-dark), -12px -12px 20px var(--shadow-light);
      }
      
      h1, h2, h3 {
        color: var(--primary-text-color);
        font-weight: 600;
      }
      
      h1 {
        font-size: 2.5rem;
        margin-bottom: 0.25rem;
      }
      
      h2 {
        font-size: 1.75rem;
        margin-bottom: 1.5rem;
        font-weight: 500;
        border-bottom: 1px solid var(--shadow-dark);
        padding-bottom: 10px;
      }
      
      h3 {
        font-size: 1.2rem;
        margin-bottom: 0.25rem;
      }
      
      a {
        color: var(--highlight-color);
        text-decoration: none;
        font-weight: 500;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
      }
      
      .contact-info {
        display: grid;
        gap: 8px;
        text-align: right;
        font-size: 0.9rem;
      }

      .contact-info p {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
      }

      .contact-info i {
        width: 20px;
        text-align: center;
        color: var(--primary-text-color);
      }
      
      ul {
        padding-left: 25px;
        list-style: none;
      }
      
      li {
        position: relative;
        margin-bottom: 15px;
      }

      li::before {
        content: '›';
        position: absolute;
        left: -20px;
        top: -2px;
        font-size: 1.5rem;
        color: var(--highlight-color);
        font-weight: bold;
      }
      
      .skills-list {
        list-style-type: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
      }
      
      .skills-list li {
        margin: 0;
        padding: 10px 20px;
        border-radius: 12px;
        background: var(--bg-color);
        box-shadow: inset 4px 4px 8px var(--shadow-dark), inset -4px -4px 8px var(--shadow-light);
        color: var(--primary-text-color);
        font-weight: 500;
        transition: all 0.2s ease;
      }

      .skills-list li:hover {
        color: var(--highlight-color);
      }

      .skills-list li::before {
        content: none; /* Remove default list style */
      }
      
      .references {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 30px;
      }
      
      .reference-item {
        flex: 1;
        min-width: 250px;
      }

      .job-title, .degree-info {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
      }

      .job-title p, .degree-info p {
        font-style: italic;
        color: var(--secondary-text-color);
        font-size: 0.9rem;
      }

      //- ⬇⬇⬇ 新增：打印样式和自定义页眉页脚 ⬇⬇⬇
      @media print {
        :root {
          /* 在打印时覆盖颜色变量为黑白色系 */
          --primary-text-color: #000000;
          --secondary-text-color: #333333;
        }

        body {
          background-color: #ffffff;
          padding: 0; /* 移除body边距，交由@page控制 */
        }

        .container {
          gap: 20px; /* 缩小打印时间距 */
          max-width: 100%;
        }

        .card {
          /* 移除Soft UI效果，改为清晰的边框 */
          box-shadow: none;
          border: 1px solid #cccccc;
          border-radius: 8px;
          padding: 1.5rem;
          /* 防止卡片在页面中断开 */
          break-inside: avoid;
        }

        .card:hover {
          transform: none;
        }
        
        h2 {
          border-color: #cccccc;
        }
        
        a {
          color: #000000;
          text-decoration: underline;
        }

        .skills-list li {
          box-shadow: none;
          border: 1px solid #cccccc;
          background: #ffffff;
        }

        /* 隐藏不必要的视觉元素 */
        .contact-info i {
          display: none;
        }
        
        @page {
          /* 设置打印页边距 */
          margin: 0.75in;

          /* 定义页脚内容 */
          @bottom-left {
            content: "Qi Chen - Full-stack Developer";
            font-family: 'Poppins', sans-serif;
            font-size: 9pt;
            color: #666666;
          }
          @bottom-center {
            content: "https://www.linkedin.com/in/qi-chen-7b265130b/";
            font-family: 'Poppins', sans-serif;
            font-size: 9pt;
            color: #666666;
            text-decoration: underline;
          }
          @bottom-right {
            content: "Page " counter(page) " of " counter(pages);
            font-family: 'Poppins', sans-serif;
            font-size: 9pt;
            color: #666666;
          }

          /* 清空默认页眉 */
          @top-left { content: ""; }
          @top-center { content: ""; }
          @top-right { content: ""; }
        }
      }
      //- ⬆⬆⬆ 新增样式结束 ⬆⬆⬆

