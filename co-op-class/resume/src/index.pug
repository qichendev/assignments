doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Qi Chen - Full-stack Developer
    style.
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        margin: 20px;
      }
      h1, h2, h3 {
        color: #333;
        margin: 0;
      }
      h1 {
        font-size: 16pt;
      }
      a {
        color: #007BFF;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      .header {
        text-align: left;
        margin-bottom: 20px;
      }
      .contact-info p {
        margin: 5px 0;
      }
      .section {
        margin-top: 15px;
        margin-bottom: 20px;
      }
      .section h2 {
        border-bottom: 1px solid #333;
        padding-bottom: 5px;
        margin-bottom: 10px;
      }
      ul {
        padding-left: 20px;
      }
      li {
        margin-bottom: 10px;
      }
      .skills-list {
        list-style-type: none;
        padding: 0;
      }
      .skills-list li {
        display: inline-block;
        background-color: #f2f2f2;
        padding: 5px 10px;
        margin: 5px;
        border-radius: 5px;
      }
      .education-item, .job {
        margin-bottom: 15px;
      }
      
      /* 打印样式 - 去除页眉页脚 */
      @media print {
        @page {
          margin: 0.5in;
          size: A4;
        }
        
        /* 去除页眉页脚的日期和文件路径 */
        @page :first {
          margin-top: 0.5in;
        }
        
        @page :left {
          margin-left: 0.5in;
        }
        
        @page :right {
          margin-right: 0.5in;
        }
        
        /* 确保内容不会被页眉页脚遮挡 */
        body {
          margin: 0;
          padding: 0;
        }
        
        /* 隐藏链接的URL显示 */
        a[href]:after {
          content: none !important;
        }
      }

