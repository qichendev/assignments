@model MoviesManager.Models.Movie
@{
    ViewData["Title"] = "Create New Movie";
}

<div class="text-center">
    <h1 class="display-4">Create New Movie</h1>
</div>

<form method="post">
    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label">Title</label>
        <input asp-for="Title" class="form-control">
    </div>
    <div class="form-group mb-3">
        <label asp-for="Director" class="form-label">Director</label>
        <input asp-for="Director" class="form-control">
    </div>
    <div class="form-group mb-3">
        <label asp-for="Genre" class="form-label">Genre</label>
        <input asp-for="Genre" class="form-control">
    </div>
    <div class="form-group mb-3">
        <label asp-for="Year" class="form-label">Year</label>
        <input asp-for="Year" class="form-control">
    </div>
    <div class="form-group mb-3">
        <label asp-for="Rating" class="form-label">Rating</label>
        <input asp-for="Rating" class="form-control">
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
