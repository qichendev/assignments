@model IEnumerable<MoviesManager.Models.Movie>
@{
    ViewData["Title"] = "Movies List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 fw-bold">
            <i class="bi bi-film"></i> Movies Library
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Movie
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No movies found. Click <strong>Add New Movie</strong> to get started!
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Title</th>
                            <th scope="col">Director</th>
                            <th scope="col">Genre</th>
                            <th scope="col">Year</th>
                            <th scope="col">Rating</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td class="text-muted">@movie.Id</td>
                                <td class="fw-semibold">@movie.Title</td>
                                <td>@movie.Director</td>
                                <td>
                                    <span class="badge bg-secondary">@movie.Genre</span>
                                </td>
                                <td>@movie.Year</td>
                                <td>
                                    <span class="badge @(movie.Rating >= 8 ? "bg-success" : movie.Rating >= 6 ? "bg-warning text-dark" : "bg-danger")">
                                        @movie.Rating / 10
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@movie.Id"
                                       class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@movie.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="text-muted mt-2">Total: @Model.Count() movies</p>
    }
</div>
